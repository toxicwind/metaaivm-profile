#!/usr/bin/env bash
# metaaivm-profile — self-test gate (PASS/FAIL).
# Agent-profile repo. Two gates:
#   1) bun test src/profile.test.ts (loads + validates the executable profile)
#   2) verify.ts type-checks under bun build (bun-native).
# ADDITIVE: commits bin/ + mise only by pathspec; the tracked package.json /
# moon.yml WIP from another writer is left untouched.
set -euo pipefail
cd "$(dirname "$0")/.."
export RUN_FAST_ACTIVE=0
BUN="${BUN:-/home/toxic/.bun/bin/bun}"; [ -x "$BUN" ] || BUN=bun

echo "== metaaivm-profile check: start =="
[ -f verify.ts ] || { echo "FAIL: verify.ts missing"; exit 1; }
[ -f profile.json ] || { echo "FAIL: profile.json missing"; exit 1; }

set +e
out="$("$BUN" build verify.ts --target=bun --outfile=/tmp/mprofile-check.js 2>&1)"
rc=$?
set -e
echo "$out"
[ "$rc" -eq 0 ] || { echo "FAIL: bun build verify.ts rc=$rc"; exit 1; }
rm -f /tmp/mprofile-check.js

set +e
tout="$("$BUN" test src/profile.test.ts 2>&1)"
trc=$?
set -e
echo "$tout"
[ "$trc" -eq 0 ] || { echo "FAIL: bun test profile.test.ts rc=$trc"; exit 1; }

echo "== metaaivm-profile check: PASS =="
exit 0